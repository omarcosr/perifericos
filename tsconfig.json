{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@tarve/core",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun", "@tarve/core/assets"]
  },
  "include": ["src"]
}
