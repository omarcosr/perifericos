{
  "name": "perifericos",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tarve run src/main.tsx --runtime bun",
    "dev:node": "tarve run src/main.tsx --runtime node",
    "build": "bun scripts/build-release.ts build",
    "release": "bun scripts/build-release.ts release",
    "check": "tsc --noEmit",
    "test": "bun test tests"
  },
  "dependencies": { "@tarve/core": "0.12.0" },
  "devDependencies": { "@types/bun": "^1.4.2", "@types/node": "^26.0.0", "resedit": "3.1.0", "typescript": "^7.0.2" },
  "tarve": {
    "name": "Periféricos",
    "icon": "src/ui/assets/app-icon.png",
    "appId": "Perifericos.Tarve",
    "description": "Controle de mouses e headsets",
    "installer": {
      "directory": "Perifericos",
      "shortcutName": "Periféricos",
      "homepage": "https://github.com/omarcosr/perifericos",
      "options": {
        "startup": {
          "default": false,
          "command": ["--enable-startup"],
          "label": { "en": "Start Periféricos in the tray when you sign in", "pt-BR": "Iniciar o Periféricos na bandeja ao entrar no Windows" }
        }
      },
      "hooks": {
        "beforeInstall": ["--stop", "--wait"],
        "afterInstall": ["--migrate-startup"],
        "beforeUninstall": [["--stop", "--wait"], ["--remove-startup"]]
      },
      "previous": {
        "uninstallKeys": ["Perifericos.Tarve_is1"],
        "files": ["unins000.exe", "unins000.dat"],
        "shortcuts": ["Periféricos Tarve.lnk"]
      }
    }
  }
}
